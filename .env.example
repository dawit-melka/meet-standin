# Copy to .env and fill in. Never commit .env.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID. Only this chat can control the bot.
ALLOWED_CHAT_ID=

# Optional. Where state.json and recordings/ live. Relative paths are resolved
# against the directory you run the bot from. Default: ./data
# DATA_DIR=./data

# Optional. The Chrome profile signed in to your Google account. Default: $DATA_DIR/profile
# PROFILE_DIR=

# Optional. DEBUG, INFO, WARNING or ERROR. Default: INFO
# LOG_LEVEL=INFO
